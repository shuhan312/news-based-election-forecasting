# Secrets — never commit API keys
.env

# Data is not stored in the repository (course policy: large files go to
# OneDrive) — except data/elections/, which is small reference data.
data/*
!data/README.md
!data/elections/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store

# runtime state of the news collection runner (derivable from search_log.csv)
news_collection/checkpoints/
# The query inventory is the frozen, pre-execution collection plan. It is
# versioned so every search-log row can join to the exact planned query.
news_collection/collection_diagnostics.json
news_collection/ward_tier_diagnostics.json
news_collection/completeness_check.json

# processed data output (one row per collected article) - regenerated by
# build_effective_dates.py from raw records + the resolution/review CSVs
# that are already tracked; too large to store directly per the IRP
# large-files rule
news_collection/effective_dates.csv

# same reasoning: one row per article, regenerated by assess_eligibility.py
news_collection/eligibility_assessment.csv

# LLM runtime audit files are generated automatically and can contain many
# near-duplicate API responses. Keep the code, methodology and compact final
# result in Git; retain raw responses and timestamped rerun backups outside
# the repository with the other generated research outputs.
news_collection/llm_v2_*_raw/
news_collection/haslemere_probe/llm_v2_raw/
news_collection/manual_review_llm_*.pre-rerun-*.csv
news_collection/html_cleaned_articles_v1.jsonl
news_collection/character_normalised_articles_v1.jsonl
news_collection/structure_normalised_articles_v1.jsonl
news_collection/structured_articles_v1.jsonl
news_collection/normalised_text_layer_v1_provisional.jsonl

# The E5-local round-2 review queue carries ~1,500-character article excerpts
# for 1,060 articles (2.3MB of publisher text). The companion _summary.json
# holds the counts, per-source rates and projection and IS committed, so every
# claim made from this queue stays checkable without the text itself.
news_collection/e5_local_review_queue_round2.csv
# Contains article excerpts for blind human E5 review. The compact JSON plan
# is versioned; the review sheet follows the repository's local-text policy.
news_collection/e5_local_risk_review_queue.csv
# Tier-tagged triage queue: replicates the round-2 excerpts above,
# so the same local-text policy applies; the JSON/MD beside it are
# committed and carry every figure.
news_features/e5_local_triage_v1/e5_local_triage_queue*.csv

# Phase 6 pilot: extraction outputs carry verbatim article quotes -
# copyright three-tier policy keeps them out of Git (local + OneDrive)
llm_context/llm_context_pilot_outputs.json
llm_context/pilot_batch_id.txt
llm_context/pilot_retry_batch_id.txt
llm_context/llm_context_revalidation_outputs.json
llm_context/reval_batch_id.txt
llm_context/issue_classification_outputs.json
llm_context/issue_cls_batch_id.txt
llm_context/issue_classification_gap_rerun_outputs.json
llm_context/issue_cls_gap_batch_id.txt
llm_context/stance_classification_outputs.json
llm_context/stance_cls_batch_id.txt
llm_context/framing_detection_outputs.json
llm_context/framing_batch_id.txt
llm_context/credit_blame_outputs.json
llm_context/credit_blame_batch_id.txt
llm_context/credit_blame_gap_batch_id.txt
llm_context/electoral_consequence_outputs.json
llm_context/elect_consq_batch_id.txt
llm_context/local_national_relevance_outputs.json
llm_context/loc_nat_batch_id.txt

# D4 validation gate: the six-layer raw outputs carry the verbatim evidence
# spans those layers require, so the same copyright three-tier policy that
# excludes the pilot outputs above applies to them (local + OneDrive). The
# compact scorecards stay in Git - they hold statistics only - and
# d4_llm_output_manifest.json records each response's hash and token counts
# so any figure can still be traced to the answer it came from.
llm_context/d4_llm_outputs.json
llm_context/d4_llm_outputs_haiku.json
llm_context/d4_batch_ids.json
llm_context/d4_batch_ids_haiku.json

# The per-experiment markdown scorecards are rendered from the .json beside
# them, and every table they contain is already in d4_findings_log.md - so
# committing both duplicates one document with another in the same commit.
# The .json stay: they carry detail the log's summary tables omit (per-party
# breakdowns, raw uncollapsed figures, penalty sweeps) and they are what
# regenerates the markdown. The two rescue scorecards are tracked from an
# earlier commit and are left alone rather than removed, since the history
# is not to be rewritten.
llm_context/d4_agreement_report*.md
llm_context/d4_coarsened_agreement*.md
llm_context/d4_inter_model_agreement.md
llm_context/reform_subfield_agreement*.md
llm_context/temporal_horizon_outputs.json
llm_context/temporal_windows_deterministic.json
llm_context/temporal_batch_id.txt
llm_context/confidence_evidence_outputs.json
llm_context/llm_context_layer_final.json
news_features/news_scope_classification.json
news_features/recency_weighted_features.csv
news_features/missing_news_representation.csv

# Run logs from the automated extraction chain and the rescue experiments.
# Progress traces of a run, not evidence - every figure they carry is
# recorded in llm_context/d4_findings_log.md against the batch that produced
# it.
llm_context/extraction_chain.log
llm_context/consequence_rescue.log

# Corpus extraction outputs. The original layers require verbatim evidence
# spans, so these files reproduce substantial article text - 582 spans and
# 77,000 characters on the 89-article tranche alone. Same copyright three-tier
# policy as d4_llm_outputs. The batch manifest and the health-check report
# stay in Git: they carry batch ids, the window census and aggregate figures,
# and reproduce no article text.
llm_context/corpus_extraction_outputs_*.json
llm_context/attribution_rescue.log

# Raw per-article outputs for the two layers the D4 gate dropped. The stance
# and framing rescue outputs stay in Git because those layers are live and
# their answers feed features; attribution and consequence feed nothing, so
# their per-article answers are dead weight - 2,572 lines of machine output
# for layers nothing will read. Traceability for a dropped layer needs the
# batch ids and the computed agreement figures, both of which stay.
llm_context/attribution_rescue_outputs*.json
llm_context/consequence_rescue_outputs*.json

# Diagnostic re-runs keep the raw model response, which reproduces evidence
# spans - 36 verbatim quotations, ~5,000 characters of article text on the far3
# diagnosis alone. Same copyright policy as the extraction outputs.
llm_context/issues_failure_diagnosis_*.json
llm_context/step2_far3_rerun.log
llm_context/full_corpus_run.log

# Full batch manifests. What collect reads - the article ids to load by and the
# per-article stance question sets - which on the full corpus is 5,975 lines of
# machine-generated ids. corpus_extraction_batch_digests.json takes their place,
# holding the batch ids, the prompt fingerprints, the census and a sha256 over
# each dropped list, so the local file can be verified as the one described.
# Same treatment d4_llm_output_manifest.json already received: 5,034 lines of
# per-article hashes reduced to 90.
llm_context/corpus_extraction_batches_*.json

# Paired-comparison bundles and their bootstrap output. Each is a full 29-file
# bundle regenerated by two CLI commands recorded in
# architecture_selection_evidence.md, and the figures that matter are in that
# document. Keeping three near-identical bundles in history buys nothing.
surrey-election-no-news-baseline/outputs/model_bundle_paired_*/
surrey-election-no-news-baseline/outputs/architecture_paired_bootstrap_*.json

# Per-article attribution detail. 1,452 rows, 252KB of a 322KB file; the summary
# beside it carries every figure the findings document cites.
news_features/article_area_attribution_per_article.json

# Scratch working directory of the Codex CLI tool; never project evidence.
.codex_work/

# By-election stage outputs, one row per collected article - regenerated by
# run_byelection_stages.py from raw records exactly as their principal
# twins effective_dates.csv / eligibility_assessment.csv are, and ignored
# for the same reason. The decision-carrying by-election files (review
# sheet, LLM output, terminal decisions, batch state) follow their tracked
# principal twins and stay IN git.
news_collection/byelection_effective_dates_v1.csv
news_collection/byelection_eligibility_assessment_v1.csv

# The v2 rerun of the same two per-article stage outputs, ignored for the
# same reason as their v1 names above.
news_collection/effective_dates_v2.csv
news_collection/eligibility_assessment_v2.csv

# Timestamped pre-rerun / pre-human backups: the live files carry the
# record, and collect/assembly never read the backups.
news_collection/*.pre-rerun-*.csv
news_collection/byelection_review.pre-human-backup.csv

# Collection run log; the compact overnight_run_summary.json is the record.
news_collection/overnight_run.log
news_collection/ward_first_summary.json

# The frozen blinded prediction files are 20MB each. Their sha256 hashes
# are committed in the evidence register and in each other's protocols, so
# the committed manifests are the tamper evidence and the files themselves
# live with the other large outputs on OneDrive.
news_features/blinded_2026_predictions_v1/blinded_predictions.csv
news_features/blinded_2026_predictions_v2/blinded_predictions.csv

# Generated research workbooks, labelling queues, progress decks and
