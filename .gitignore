outputs/d4_validation_labelling_2026_07_29/
outputs/manual_review_2026_07_29/
outputs/manual_review_queues_2026-07-29/
outputs/surrey_irp_progress_update_2026-07-14.pptx
surrey-election-extractor/outputs/final_master_workbook_2026-07-20/
news_collection/haslemere_probe/*.pre-rerun-*.csv
news_collection/e5_local_backlog_v3/byelection_review_v3.csv
news_collection/woking_south_blind/llm_v2_raw/
news_collection/woking_south_blind/review_sheet_with_human_e5.csv
news_collection/woking_south_blind/E5_review_manual_woking_south.pdf
news_collection/woking_south_blind/*.pre-rerun-*.csv
news_features/ward_party_election_features_v1/ward_party_election_features*.parquet
news_features/ward_party_election_features_v1/final_feature_dictionary.csv
news_features/ward_party_election_features_v1/final_feature_leakage_audit.csv
news_features/ward_party_election_features_v1/feature_view_manifest.json
news_features/ward_party_election_features_v1/empty_feature_columns.csv
# pre-sync safety copies duplicate a state git already keeps (the one
# tracked instance was byte-identical to full_corpus_review.csv at
# commit d2b6891); same family as the pre-rerun/pre-rebuild patterns.
news_collection/*.pre-sync-*.csv
# one-command export from scripts/export_window_scheme_comparison.py over
