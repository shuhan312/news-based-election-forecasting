# Secrets — never commit API keys
.env

# Data is not stored in the repository (course policy: large files go to
# OneDrive) — except data/elections/, which is small reference data.
data/*
!data/elections/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store

# runtime state of the news collection runner (derivable from search_log.csv)
news_collection/checkpoints/
news_collection/query_inventory.csv
news_collection/collection_diagnostics.json
news_collection/ward_tier_diagnostics.json
news_collection/completeness_check.json

# processed data output (one row per collected article) - regenerated by
# build_effective_dates.py from raw records + the resolution/review CSVs
# that are already tracked; too large to store directly per the IRP
# large-files rule
news_collection/effective_dates.csv

# same reasoning: one row per article, regenerated by assess_eligibility.py
news_collection/eligibility_assessment.csv
