{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "irp-surrey/temporal_horizon_schema_v1",
  "title": "Expected impact horizon record - LLM part (Phase 6 Step 9)",
  "description": "The LLM-derived HALF of the temporal layer: how long the article's political relevance is expected to persist, judged from CONTENT ONLY (the extractor is never shown the publication date - separation from deterministic election windows is structural). The deterministic half (days-before-polling, window membership, leakage flags) is computed in code and stored alongside, never generated by the LLM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "article_id", "canonical_article_id",
               "extraction_status", "review_status", "impact_horizon",
               "temporal_mechanism", "story_type",
               "political_linkage", "reform_uk", "evidence_span",
               "confidence"],
  "properties": {
    "schema_version": {"const": "temporal-v1.0-2026-07-27"},
    "article_id": {"type": "string", "minLength": 1},
    "canonical_article_id": {"type": "string", "minLength": 1},
    "extraction_status": {
      "enum": ["extracted", "partial", "failed", "not_attempted"]},
    "review_status": {"enum": ["unreviewed", "human_reviewed", "flagged"]},
    "impact_horizon": {
      "enum": ["immediate", "short_term", "medium_term", "long_term",
               "mixed", "uncertain"],
      "description": "operational definitions in the audit: immediate = days, short_term = weeks, medium_term = months, long_term = beyond the electoral cycle / structural; mixed = distinct components at different horizons; uncertain = the article does not support a judgement"},
    "temporal_mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact_start", "persistence", "continuing_story",
                   "expected_decay", "rationale"],
      "properties": {
        "impact_start": {"enum": ["immediate", "delayed", "uncertain"]},
        "persistence": {"enum": ["one_off", "recurring", "continuing",
                                 "structural", "uncertain"]},
        "continuing_story": {"enum": ["yes", "no", "uncertain"]},
        "expected_decay": {"enum": ["rapid", "gradual", "persistent",
                                    "uncertain"]},
        "rationale": {"type": "string", "minLength": 10,
                      "description": "the temporal reasoning, grounded in the article"}
      }
    },
    "story_type": {
      "enum": ["sudden_campaign_shock", "developing_controversy",
               "recurring_service_problem",
               "sustained_national_trend", "long_running_issue",
               "election_administration_event", "none_political",
               "other"]},
    "political_linkage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affected_actor", "affected_voter_group",
                   "relevant_issue", "signal_temporality",
                   "national_precedes_local"],
      "properties": {
        "affected_actor": {"oneOf": [{"type": "string"},
                                     {"type": "null"}]},
        "affected_voter_group": {"oneOf": [{"type": "string"},
                                           {"type": "null"}]},
        "relevant_issue": {
          "oneOf": [{"enum": ["council_finance", "council_tax",
                              "roads_transport", "planning_housing",
                              "schools_send", "social_care",
                              "waste_recycling", "crime_policing",
                              "environment_flooding", "healthcare",
                              "local_business", "immigration",
                              "council_performance",
                              "candidate_party_conduct", "scandal",
                              "protest", "service_closure",
                              "investment_funding",
                              "local_government_reorganisation",
                              "candidate_selection_withdrawal",
                              "resignation_defection",
                              "new_party_emergence",
                              "voter_switching",
                              "anti_incumbent_sentiment",
                              "election_administration",
                              "national_politics",
                              "national_economy", "other"]},
                    {"type": "null"}]},
        "signal_temporality": {
          "enum": ["temporary", "cumulative", "uncertain"],
          "description": "does the article's consequence signal read as a one-time blip or as part of an accumulating pattern"},
        "national_precedes_local": {
          "type": "boolean",
          "description": "true ONLY when the article itself suggests national momentum may precede local electoral conversion"}
      }
    },
    "reform_uk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "confidence"],
      "properties": {
        "applicable": {"type": "boolean"},
        "temporal_character": {
          "type": "array",
          "items": {"enum": ["short_lived_publicity",
                             "continuing_national_momentum",
                             "sustained_local_campaign_development",
                             "long_term_challenger_emergence"]},
          "description": "the specification's four Reform temporal distinctions; empty unless supported"},
        "evidence_span": {"oneOf": [{"$ref": "#/$defs/evidence_span"},
                                    {"type": "null"}]},
        "confidence": {"type": "number", "minimum": 0.0,
                       "maximum": 1.0}
      }
    },
    "evidence_span": {
      "oneOf": [{"$ref": "#/$defs/evidence_span"}, {"type": "null"}],
      "description": "supports the impact-horizon judgement; null ONLY when impact_horizon is uncertain (rule H3)"},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "ambiguity_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": {"reason": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "evidence_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 10},
        "from_title": {"type": "boolean", "default": false}
      }
    }
  }
}
