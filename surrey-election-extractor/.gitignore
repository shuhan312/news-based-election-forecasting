# Local Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
# Local Codex runtime link used only to run the artifact-tool workbook builder.
scripts/node_modules

# Generated research outputs and local logs
*.xlsx
*.xls
*.log

# Reproducible intermediate election outputs are stored in OneDrive, not Git.
outputs/*_full_extraction/
outputs/*_archive_discovery_pilot/
outputs/*_official_pilot/
outputs/*_seats_diagnosis*/
outputs/*_secondary_seats_audit/
outputs/*_division_supplementary_audit/
outputs/2026_compatibility_audit/*.json

# Detailed generated JSON audits remain local or in OneDrive.
outputs/*_layered_completeness/*.json
outputs/final_position_provenance_audit/*.json
# The final-position release package is regenerated from tracked code and
# evidence configuration. Keep its JSON/CSV reports in OneDrive or local
# storage rather than inflating the repository with generated outputs.
outputs/final_position_qa/
outputs/geographic_mapping_audit/*.json
outputs/geographic_overlap_audit/
outputs/geographic_mapping_review/*.json
outputs/geographic_mapping_decision/*.json
outputs/geographic_crosswalk_resolution/*.json
outputs/master_surrey_election_database/
outputs/election_event_timeline/*.json
outputs/historical_baseline_features/*.json
outputs/historical_reference_permissions/*.json
outputs/by_election_integration/*.json
outputs/by_election_source_recovery/*.json
outputs/final_election_data_release_audit/
# The repeated-name review queue can contain hundreds of candidate appearances.
# Keep this generated audit local or in OneDrive; the script reproduces it.
outputs/candidate_continuity_review/

# Local secrets and API-key files
.env
.env.*
*.key
secrets.toml
.streamlit/secrets.toml
