      "lgbce-surrey-final-recommendations-2024",
      "ons-surrey-county-electoral-divisions-may-2023"
    ],
    "minimum_mutual_overlap_percentage": 99.9,
    "maximum_competing_overlap_percentage": 0.1,
    "permitted_features": [
      "previous_election_event",
      "previous_winner_status",
      "previous_winning_candidate_name_source_reported_only",
      "previous_winning_party",
      "previous_winning_candidate_vote_share",
      "previous_turnout",
      "previous_competitiveness",
      "previous_electorate",
      "area_specific_exact_party_history"
    ],
    "prohibited_features": [
      "candidate_identity_transfer",
      "incumbency_transfer",
      "predecessor_councillor_transfer",
      "party_vote_share_change",
      "party_swing",
      "vote_redistribution"
    ],
    "limitation": "Approval establishes analytical geographic continuity only. It does not claim that the historic and current electoral divisions have the same legal identity, and it never authorises a candidate-identity or vote-redistribution inference."
  },
